{
  "name": "janix-mobile-editor",
  "productName": "JaniX",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "JaniX for Android and iPhone: the JaniX code editor as an installable web app and a Capacitor app.",
  "author": "Janin A Apurba",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "serve": "node build.mjs --serve",
    "android": "node build.mjs && npx cap sync android",
    "ios": "node build.mjs && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@isomorphic-git/lightning-fs": "4.10.3",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "buffer": "6.0.3",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "isomorphic-git": "1.44.3",
    "jszip": "3.10.2",
    "marked": "18.1.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "esbuild": "0.28.2"
  }
