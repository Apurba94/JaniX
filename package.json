{
  "name": "janix",
  "productName": "JaniX",
  "version": "1.1.0",
  "description": "JaniX: a fast code editor for Windows, built on the Monaco editor that powers VS Code.",
  "author": "Janin A Apurba",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:setup": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "monaco-editor": "0.57.0"
  },
  "build": {
    "appId": "com.janinapurba.janix",
    "productName": "JaniX",
    "copyright": "Copyright © 2026 Janin A Apurba",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "node_modules/monaco-editor/min/**/*",
      "!node_modules/monaco-editor/{dev,esm}/**",
      "!node_modules/@types/**",
      "!node_modules/**/*.{md,map,ts}",
      "!node_modules/@lydell/node-pty*/**/{src,third_party,deps}/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "JaniX.exe"
    },
    "nsis": {
      "artifactName": "JaniX-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "JaniX",
      "include": "build/installer.nsh",
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "JaniX ${version}",
      "license": "LICENSE"
    }
  }
}
